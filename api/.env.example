APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO

# Runtime oficial Docker usa DATABASE_URL configurada pelo docker-compose.dev.yml:
# postgresql+asyncpg://controle_dev:controle_dev@postgres:5432/controle_producao_dev
#
# Alternativa local nao recomendada, quando necessaria para diagnostico:
DATABASE_URL=postgresql+asyncpg://controle_dev:controle_dev@127.0.0.1:55432/controle_producao_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

SECRET_KEY=controle-producao-api-dev-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=4
PASSWORD_MAX_LENGTH=256
JWT_ISSUER=controle-producao-api
JWT_AUDIENCE=controle-producao-clients

CORS_ALLOWED_ORIGINS=

# Protecao defensiva de versao minima do cliente (Fase 06) -- ver
# docs/architecture/FASE6_COMPATIBILIDADE_DE_VERSOES.md. Desligado por
# padrao; so habilitar depois de confirmar que a frota suportada ja envia
# o header X-Client-Version corretamente.
CLIENT_VERSION_ENFORCEMENT_ENABLED=false

# Cifra a chave da API do Nomus em repouso no Postgres (system_metadata).
# Gere um valor forte por ambiente; trocar este valor invalida chaves ja salvas.
NOMUS_ENCRYPTION_KEY=

# Backup pre-deployment (Fase 05) -- ver docs/architecture/BACKUP_PRE_DEPLOYMENT.md
# Diretorio exclusivo dos dumps + manifests, resolvido relativo a raiz do repositorio
# quando informado como caminho relativo. Fora da pasta temporaria da aplicacao e fora
# de qualquer diretorio que o deployment substitua.
BACKUP_DIR=backups/predeployment
# pg_dump/pg_restore precisam estar no PATH do host/container que rodar o backup
# (a imagem da API nao inclui o cliente Postgres por padrao). Informe caminho absoluto
# se nao estiverem no PATH.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_TIMEOUT_SECONDS=900
BACKUP_MIN_FREE_SPACE_MB=500
BACKUP_LOCK_TIMEOUT_SECONDS=1800
BACKUP_RETENTION_KEEP_LAST_SUCCESSFUL=10
BACKUP_RETENTION_MINIMUM_AGE_DAYS=7

# Servidor distribuidor de atualizacoes do Desktop (Fase 12) -- ver
# docs/architecture/UPDATE_DISTRIBUTION_SERVICE.md. Caminho relativo e
# resolvido a partir da raiz do repositorio; use caminho absoluto/volume
# persistente em producao (nunca a camada gravavel efemera do container).
UPDATE_REPOSITORY_DIR=data/updates/desktop
UPDATE_LOCK_TIMEOUT_SECONDS=600
UPDATE_DOWNLOAD_GRANT_EXPIRE_SECONDS=1800

# Notificacoes multicanal (Fase 10) -- canal de e-mail. Desligado por padrao:
# so ativa quando NOTIFICATIONS_EMAIL_ENABLED=true E SMTP_HOST/SMTP_FROM estao
# preenchidos. Sem isso as NotificationDelivery de e-mail ficam registradas mas
# nao sao enviadas (o restante das notificacoes -- sino, bandeja -- funciona
# normalmente).
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_DELIVERY_INTERVAL_SECONDS=45
NOTIFICATIONS_DIGEST_HOUR=7
NOTIFICATIONS_EMAIL_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
